# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose

# Public site URL (used for share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (owner only). Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Secret for the daily alert endpoint and share PIN cookies
CRON_SECRET=change-me-long-random

# File storage (optional). Leave empty to keep files in Supabase (1 GB free).
# For free 10 GB+, use Cloudflare R2 or Backblaze B2 (both S3-compatible):
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- OR: use your own PostgreSQL (Railway) instead of Supabase. Then leave the SUPABASE_* lines empty. ---
DATABASE_URL=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
